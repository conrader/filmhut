# pai-pro — env template (deAPI compute fork).
#
# The embedded terminal runs the coding agent selected for each project.
# New projects default to Claude Code; set PAI_DEFAULT_AGENT_ID=codex to
# make new projects use Codex CLI instead.
#
# One DEAPI_KEY covers every capability (image, image pro, video,
# voice, video upscaling) via the deAPI v2 media API
# (https://deapi.ai). Generated assets are mirrored into
# projects/<id>/assets/ and served back to the browser by the viewer
# — no cloud bucket / object storage in the loop. Reference files are
# uploaded to deAPI directly as multipart form data, so no tunnel is
# required for refs.
#
# Without DEAPI_KEY set, the media CLIs fail at call time with a clean
# infra-class error; the canvas, terminal, and notes still work.

# --- deAPI media API (image + image pro + video + voice + upscale) ---
# Get your key at https://app.deapi.ai/dashboard/api-keys.
# New accounts receive $5 free credits.
DEAPI_KEY=

# Optional override of the deAPI base URL (default https://api.deapi.ai).
# DEAPI_API_BASE=https://api.deapi.ai

# --- deAPI model slugs (all optional; the values shown are the built-in
#     defaults). The catalog is ACCOUNT-SCOPED, so discover yours with
#     `node scripts/deapi-doctor.mjs`, which also verifies each slug
#     supports the inference type we call it with. ---
# DEAPI_IMAGE_MODEL=Flux1schnell                  # standard text-to-image
# DEAPI_IMAGE_EDIT_MODEL=Flux_2_Klein_4B_BF16     # standard ref-based edits
# DEAPI_IMAGE_PRO_MODEL=Flux_2_Klein_4B_BF16      # pro text-to-image
# DEAPI_IMAGE_PRO_EDIT_MODEL=Flux_2_Klein_4B_BF16 # pro ref-based edits
# DEAPI_VIDEO_MODEL=Ltx2_3_22B_Dist_INT8          # text/image/audio → video
# DEAPI_TTS_MODEL=Qwen3_TTS_12Hz_1_7B_VoiceDesign # voice-design briefs
# DEAPI_UPSCALE_MODEL=FlashVSR_Tiny               # video upscale (scale 2-4)
#
# Notable alternatives on the same account:
#   QwenImageEdit_Plus_NF4  precision single-ref instruction edits, but
#                           1 reference image only and ~5x the price of
#                           Flux.2 Klein's 3-reference edit route.
#   Kokoro                  preset-voice TTS, ~17x cheaper per character
#                           than voice-design, but ignores the voice brief.
#   Ltxv_13B_0_9_8_Distilled_FP8  cheaper/faster video, 768px cap, 30 fps,
#                           no audio track and no audio-conditioned route.

# --- Legacy PAI media API (retired as compute supplier) ---
# Only the asset-preupload chip UX reads this; leave unset.
# PAI_KEY=

# --- Project agent ---
# Supported values: claude, codex. Existing projects keep their saved
# agent_id; this only affects projects created after the viewer starts.
# Docker also reads this value; one-shot overrides work:
# PAI_DEFAULT_AGENT_ID=codex ./scripts/docker-start.sh
# PAI_DEFAULT_AGENT_ID=claude

# --- Agent permissions (DANGEROUS) ---
# Each project's agent launches fully unattended by default: it bypasses
# per-action permission/sandbox prompts (claude --dangerously-skip-permissions,
# codex --dangerously-bypass-approvals-and-sandbox) and pre-trusts the project
# folder in the agent's trust store (~/.claude.json, ~/.codex/config.toml) so
# "do you trust this folder?" doesn't block startup. The agent runs in the
# project's own cwd (externally sandboxed inside Docker). Set to 0 to restore
# both the prompts and the trust gate.
# PAI_AGENT_BYPASS=0

# (PAI_API_BASE was the old compute supplier's override; superseded by
# DEAPI_API_BASE above.)

# --- Local ports ---
# Override per clone to run multiple instances of this repo side-by-side
# on the same machine. Leave blank to use the defaults (7488 / 7443).
# start.sh derives WEB_ORIGIN and VITE_VIEWER_URL from these, so you
# don't have to.
VIEWER_PORT=7488
WEB_PORT=7443

# --- Optional: public tunnel (NOT needed for deAPI refs) ---
# deAPI receives reference files as direct multipart uploads, so media
# generation works without any tunnel. ./start.sh may still auto-launch
# `cloudflared tunnel` (writes .tunnel_url) for viewer-sharing use cases;
# set this to use your own tunnel instead — start.sh skips the auto-launch.
# PUBLIC_VIEWER_URL=

# --- Docker only (ignored by ./start.sh) ---
# Host-side port the Docker viewer is mapped to. Default 7588 so a host
# `./scripts/start.sh` on 7488 can coexist with Docker. Set to 7488
# if you're not running the host viewer in parallel.
# HOST_VIEWER_PORT=7588
